{
  "name": "oudeluck-loft-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "seed:generate": "node --no-warnings --experimental-strip-types db/seed/generate-seed.ts > db/seed.sql",
    "db:local": "wrangler d1 execute loft-ring-book --local --file=db/schema.sql && wrangler d1 execute loft-ring-book --local --file=db/seed.sql",
    "cf:dev": "npm run build && wrangler pages dev"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.159.0"
  }
}
